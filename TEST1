local CONNECTIONS = {}
local FLAGS = {
    PunchFarm   = false,
    ToolFarm    = false,
    KillAura    = false,
    KillList    = false,
    Range       = 25,
    Rebirth     = false,
    AutoSize1   = false,
    AutoSprint  = false,
    InfiniteJump= false,
    AntiAFK     = false,
}
local UNLOADED = false
local START_TICK = tick()

local function track(conn)
    if conn then table.insert(CONNECTIONS, conn) end
    return conn
end

local function disconnectAll()
    for _, c in ipairs(CONNECTIONS) do
        pcall(function() c:Disconnect() end)
    end
    CONNECTIONS = {}
end

local function DeepFind(p, name)
    local f = p:FindFirstChild(name)
    if f then return f end
    for _, v in pairs(p:GetDescendants()) do
        if v.Name == name then return v end
    end
end

local function GetREvents()
    return RPS:FindFirstChild("rEvents")
end

local function GetMuscleEvent()
    local r = GetREvents()
    if r and r:FindFirstChild("muscleEvent") then return r.muscleEvent end
    return DeepFind(RPS, "muscleEvent") or DeepFind(RPS, "MuscleEvent")
end

local function GetRebirthRemote()
    local r = GetREvents()
    if r and r:FindFirstChild("rebirthRemote") then return r.rebirthRemote end
    return DeepFind(RPS, "rebirthRemote") or DeepFind(RPS, "RebirthRemote")
end

local function GetChar() return LP.Character end
local function GetHRP()
    local c = GetChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function GetHum()
    local c = GetChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function Notify(text)
    pcall(function()
        SG_svc:SetCore("SendNotification", {
            Title = "KhoiFarm", Text = tostring(text), Duration = 3
        })
    end)
end

local function Fire(remote, ...)
    if not remote then return end
    pcall(function()
        if remote:IsA("RemoteFunction") then
            remote:InvokeServer(...)
        else
            remote:FireServer(...)
        end
    end)
end

-- ============================================
-- AUTO TOOL FARM
-- ============================================
local lastTool = 0
local function ToolFarm()
    if not FLAGS.ToolFarm then return end
    if tick() - lastTool < 0.2 then return end
    lastTool = tick()

    local char = GetChar()
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end

    local equipped = nil
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Tool") then
            equipped = v
            break
        end
    end

    if not equipped then
        local bp = LP:FindFirstChild("Backpack")
        if bp then
            for _, v in ipairs(bp:GetChildren()) do
                if v:IsA("Tool") then
                    pcall(function() hum:EquipTool(v) end)
                    return
                end
            end
        end
        return
    end

    pcall(function() equipped:Activate() end)
end

-- ============================================
-- AUTO PUNCH FARM
-- ============================================
local lastPunch = 0
local function PunchFarm()
    if not FLAGS.PunchFarm then return end
    if tick() - lastPunch < 0.1 then return end
    lastPunch = tick()

    local hum = GetHum()
    if not hum or hum.Health <= 0 then return end

    local m = GetMuscleEvent()
    if not m then return end

    Fire(m, "punch", "leftHand")
    Fire(m, "punch", "rightHand")
end

-- ============================================
-- KILL AURA / KILL LIST
-- ============================================
local lastKill = 0
local function KillAura()
    if not (FLAGS.KillAura or FLAGS.KillList) then return end
    if tick() - lastKill < 0.08 then return end
    lastKill = tick()

    local h = GetHRP()
    if not h then return end

    for _, p in ipairs(PL:GetPlayers()) do
        if p ~= LP and p.Character then
            local th = p.Character:FindFirstChild("HumanoidRootPart")
            local hm = p.Character:FindFirstChildOfClass("Humanoid")
            if th and hm and hm.Health > 0 then
                local d = (h.Position - th.Position).Magnitude
                local shouldAttack = false
                if FLAGS.KillList and d < 20 then shouldAttack = true end
                if FLAGS.KillAura and d < FLAGS.Range then shouldAttack = true end
                if shouldAttack then
                    local m = GetMuscleEvent()
                    if m then
                        Fire(m, "punch", "leftHand")
                        Fire(m, "punch", "rightHand")
                    end
                    break
                end
            end
        end
    end
end

