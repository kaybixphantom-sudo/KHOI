    TKS.Toggle("Kill List", "Đấm người gần dưới 20 studs", function(s) FLAGS.KillList = s end)
    local AKS = KT.NewSection("Kill Aura")
    AKS.Slider("Range", "", 100, 1, function(v) FLAGS.Range = v end)
    AKS.Toggle("Kill Aura", "Tự động đấm người trong tầm", function(s) FLAGS.KillAura = s end)

    -- ===== TAB FARMING =====
    local FT = NewTab("Farming")

    local PSec = FT.NewSection("Auto Farm")
    PSec.Label("Bật CẢ 2 để farm nhanh nhất")
    PSec.Toggle("Auto Tool Farm", "Tự dùng tool tập (nhanh nhất)", function(s) FLAGS.ToolFarm = s end)
    PSec.Toggle("Auto Punch Farm", "Tự đấm tay (bổ trợ)", function(s) FLAGS.PunchFarm = s end)

    local RSec = FT.NewSection("Rebirth")
    local RebCount = RSec.Label("Rebirths: 0")
    RSec.Toggle("Auto Rebirth", "Tự động rebirth (5s/lần)", function(s) FLAGS.Rebirth = s end)
    RSec.Toggle("Auto Size 1", "Tự thu nhỏ nhân vật", function(s) FLAGS.AutoSize1 = s end)

    local GSec = FT.NewSection("Glitching")
    GSec.Button("Anti Lag", "", function()
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Trail")
            or v:IsA("Smoke") or v:IsA("Fire") then
                pcall(function() v.Enabled = false end)
            end
        end
        Notify("Đã tắt hiệu ứng!")
    end)

    -- ===== TAB SPECS =====
    local ST = NewTab("Specs")
    local SSec = ST.NewSection("Stats")
    local nameLbl = SSec.Label("Name: N/A")
    local userLbl = SSec.Label("Username: N/A")
    local strLbl  = SSec.Label("Strength: N/A")
    local rebLbl  = SSec.Label("Rebirths: N/A")
    local durLbl  = SSec.Label("Durability: N/A")
    local agiLbl  = SSec.Label("Agility: N/A")

    -- ===== TAB INVENTORY =====
    local IT = NewTab("Inventory")
    local ISec = IT.NewSection("Backpack Items")
    local InvLbl   = ISec.Label("Đang đọc...")
    local EquipLbl = ISec.Label("Equipped: ...")

    -- ===== TAB TELEPORTS =====
    local TT = NewTab("Teleports")
    local TSec = TT.NewSection("Main")
    local function TP(cf)
        local h = GetHRP()
        if h then
            pcall(function() h.CFrame = cf end)
        end
    end
    TSec.Button("Spawn", "", function() TP(CFrame.new(0, 8, 0)) end)
    TSec.Button("Muscle King Gym", "", function() TP(CFrame.new(-8600, 8, -5700)) end)
    TSec.Button("Jungle Gym", "", function() TP(CFrame.new(-1830, 8, 1660)) end)
    TSec.Button("Legends Gym", "", function() TP(CFrame.new(4600, 8, -3800)) end)

    -- ===== TAB STATS =====
    local StT = NewTab("Stats")
    local ElS = StT.NewSection("Elapsed Time")
    local TimeLbl = ElS.Label("0d 0h 0m 0s")

    -- ===== MAIN LOOP =====
    local acc = { stats = 0, inv = 0, rebirth = 0, sprint = 0 }
    track(RS.Heartbeat:Connect(function(dt)
        if UNLOADED then return end

        acc.sprint = acc.sprint + dt
        if acc.sprint >= 0.1 then
            acc.sprint = 0
            if FLAGS.AutoSprint then
                local h = GetHum()
                if h then h.WalkSpeed = 100 end
            end
        end

        ToolFarm()
        PunchFarm()
        KillAura()

        acc.stats = acc.stats + dt
        if acc.stats >= 1 then
            acc.stats = 0
            local e = tick() - START_TICK
            local d = math.floor(e / 86400)
            local hh = math.floor((e % 86400) / 3600)
            local mm = math.floor((e % 3600) / 60)
            local ss = math.floor(e % 60)
            TimeLbl.Text = string.format("%dd %dh %dm %ds", d, hh, mm, ss)

            local stats = LP:FindFirstChild("leaderstats") or LP:FindFirstChild("Stats")
            if stats then
                local function gs(n)
                    local s = stats:FindFirstChild(n)
                    return s and s.Value or "N/A"
                end
                strLbl.Text = "Strength: "   .. tostring(gs("Strength"))
                rebLbl.Text = "Rebirths: "   .. tostring(gs("Rebirths"))
                durLbl.Text = "Durability: " .. tostring(gs("Durability"))
                agiLbl.Text = "Agility: "    .. tostring(gs("Agility"))
                RebCount.Text = "Rebirths: " .. tostring(gs("Rebirths"))
            end
            nameLbl.Text = "Name: "     .. LP.DisplayName
            userLbl.Text = "Username: " .. LP.Name
        end

        acc.rebirth = acc.rebirth + dt
        if acc.rebirth >= 5 then
            acc.rebirth = 0
            if FLAGS.Rebirth then
                Fire(GetRebirthRemote(), "rebirthRequest")
            end
            if FLAGS.AutoSize1 then
                local c = GetChar()
                if c then pcall(function() c:ScaleTo(0.1) end) end
            end
        end

        acc.inv = acc.inv + dt
        if acc.inv >= 1.5 then
            acc.inv = 0
            local bp = LP:FindFirstChild("Backpack")
            local char = GetChar()
            local bag, eq = {}, {}
            if bp then
                for _, v in pairs(bp:GetChildren()) do
                    if v:IsA("Tool") then table.insert(bag, v.Name) end
                end
            end
            if char then
                for _, v in pairs(char:GetChildren()) do
                    if v:IsA("Tool") then table.insert(eq, v.Name) end
                end
            end
            InvLbl.Text = "Backpack (" .. #bag .. "): " .. table.concat(bag, ", ")
            EquipLbl.Text = "Equipped: " .. table.concat(eq, ", ")
        end
    end))

    track(LP.CharacterAdded:Connect(function()
        task.wait(1)
        if FLAGS.AutoSprint then
            local h = GetHum()
            if h then h.WalkSpeed = 100 end
        end
        lastPunch = 0
        lastTool = 0
        lastKill = 0
    end))

    StartAntiAFK()

    Notify("KhoiFarm loaded! Key: " .. TargetKey)
end

