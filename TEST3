    local GymSec = TT.NewSection("Gyms")
    GymSec.Button("Muscle King Gym", "", function() TP(CFrame.new(-8600, 8, -5700)) end)
    GymSec.Button("Jungle Gym", "", function() TP(CFrame.new(-1830, 8, 1660)) end)
    GymSec.Button("Legends Gym", "", function() TP(CFrame.new(4600, 8, -3800)) end)
    GymSec.Button("Mythical Gym", "", function() TP(CFrame.new(-4000, 8, 4000)) end)
    GymSec.Button("Eternal Gym", "", function() TP(CFrame.new(-5000, 8, 2000)) end)
    GymSec.Button("Frost Gym", "", function() TP(CFrame.new(0, 8, -5000)) end)
    GymSec.Button("Industrial Gym", "", function() TP(CFrame.new(10000, 8, 10000)) end)

    local StT = NewTab("Stats")
    local ElS = StT.NewSection("Elapsed Time")
    local TimeLbl = ElS.Label("0d 0h 0m 0s")

    local DSec = StT.NewSection("Debug")
    DSec.Button("DUMP REMOTES", "", DumpRemotes)
    DSec.Button("DUMP TOOLS", "", DumpTools)

    local acc = {stats=0, inv=0, rebirth=0, sprint=0, crystal=0, sell=0,
                 upgrade=0, gym=0, gift=0}
    track(RS.Heartbeat:Connect(function(dt)
        if UNLOADED then return end
        if not SG.Parent then return end
        local ok, err = pcall(function()
            acc.sprint = acc.sprint + dt
            if acc.sprint >= 0.1 then
                acc.sprint = 0
                if FLAGS.AutoSprint then
                    local h = GetHum()
                    if h then h.WalkSpeed = math.max(FLAGS.SpeedValue, 100) end
                end
            end

            ToolFarm(); PunchFarm(); KillAura()

            acc.stats = acc.stats + dt
            if acc.stats >= 1 then
                acc.stats = 0
                local e = tick() - START_TICK
                local d = math.floor(e/86400)
                local hh = math.floor((e%86400)/3600)
                local mm = math.floor((e%3600)/60)
                local ss = math.floor(e%60)
                TimeLbl.Text = string.format("%dd %dh %dm %ds", d, hh, mm, ss)

                local stats = LP:FindFirstChild("leaderstats") or LP:FindFirstChild("Stats")
                if stats then
                    local function gs(n)
                        local s = stats:FindFirstChild(n)
                        return s and s.Value or "N/A"
                    end
                    strLbl.Text = "Strength: "..tostring(gs("Strength"))
                    rebLbl.Text = "Rebirths: "..tostring(gs("Rebirths"))
                    durLbl.Text = "Durability: "..tostring(gs("Durability"))
                    agiLbl.Text = "Agility: "..tostring(gs("Agility"))
                    killLbl.Text = "Kills: "..tostring(gs("Kills"))
                    evLbl.Text = "Evil Karma: "..tostring(gs("Evil Karma") or gs("EvilKarma"))
                    gdLbl.Text = "Good Karma: "..tostring(gs("Good Karma") or gs("GoodKarma"))
                    brLbl.Text = "Brawls: "..tostring(gs("Brawls"))
                    RebCount.Text = "Rebirths: "..tostring(gs("Rebirths"))
                end
                nameLbl.Text = "Name: "..LP.DisplayName
                userLbl.Text = "Username: "..LP.Name

                local hum = GetHum()
                if hum then
                    yhLbl.Text = "Your Health: "..math.floor(hum.Health).."/"..math.floor(hum.MaxHealth)
                end
                local target = GetPlayerFromName(FLAGS.SelectedPlayer)
                if target and target.Character then
                    local th = target.Character:FindFirstChildOfClass("Humanoid")
                    if th then
                        ehLbl.Text = "Enemy Health: "..math.floor(th.Health).."/"..math.floor(th.MaxHealth)
                    end
                end
            end

            acc.rebirth = acc.rebirth + dt
            if acc.rebirth >= 5 then
                acc.rebirth = 0
                local canRebirth = true
                if FLAGS.UseRebirthTarget and FLAGS.AutoRebirthTarget > 0 then
                    local stats = LP:FindFirstChild("leaderstats") or LP:FindFirstChild("Stats")
                    if stats then
                        local r = stats:FindFirstChild("Rebirths")
                        if r and r.Value < FLAGS.AutoRebirthTarget then
                            canRebirth = false
                        end
                    end
                end
                if FLAGS.Rebirth and canRebirth then
                    Fire(GetRebirthRemote(), "rebirthRequest")
                end
                if FLAGS.AutoSize1 then
                    local c = GetChar()
                    if c then pcall(function() c:ScaleTo(0.1) end) end
                end
            end

            acc.crystal = acc.crystal + dt
            if acc.crystal >= 0.5 then
                acc.crystal = 0
                if FLAGS.AutoCrystal then
                    Fire(GetCrystalRemote(), "openCrystalRequest", FLAGS.CrystalName)
                end
            end

            acc.sell = acc.sell + dt
            if acc.sell >= 2 then
                acc.sell = 0
                if FLAGS.AutoSell then
                    Fire(GetSellRemote(), "sellAll", "all")
                    Fire(GetSellRemote())
                end
            end

            acc.upgrade = acc.upgrade + dt
            if acc.upgrade >= 1 then
                acc.upgrade = 0
                local ur = GetUpgradeRemote()
                if ur then
                    if FLAGS.AutoUpgradeStrength then Fire(ur, "upgradeRequest", "Strength") end
                    if FLAGS.AutoUpgradeDurability then Fire(ur, "upgradeRequest", "Durability") end
                    if FLAGS.AutoUpgradeAgility then Fire(ur, "upgradeRequest", "Agility") end
                end
            end

            acc.gym = acc.gym + dt
            if acc.gym >= 5 then
                acc.gym = 0
                if FLAGS.AutoGym then
                    Fire(GetGymRemote(), "changeGymRequest", FLAGS.GymName)
                end
            end

            acc.gift = acc.gift + dt
            if acc.gift >= 10 then
                acc.gift = 0
                if FLAGS.AutoCollectGift then Fire(GetGiftRemote()) end
            end

            acc.inv = acc.inv + dt
            if acc.inv >= 1.5 then
                acc.inv = 0
                local bp = LP:FindFirstChild("Backpack")
                local char = GetChar()
                local bag, eq = {}, {}
                if bp then
                    for _, v in pairs(bp:GetChildren()) do
                        if v:IsA("Tool") then table.insert(bag, v.Name) end
                    end
                end
                if char then
                    for _, v in pairs(char:GetChildren()) do
                        if v:IsA("Tool") then table.insert(eq, v.Name) end
                    end
                end
                InvLbl.Text = "Backpack ("..#bag.."): "..table.concat(bag, ", ")
                EquipLbl.Text = "Equipped: "..table.concat(eq, ", ")
            end
        end)
        if not ok then warn("[KhoiFarm loop] "..tostring(err)) end
    end))

    track(LP.CharacterAdded:Connect(function()
        task.wait(1)
        if UNLOADED then return end
        local h = GetHRP()
        if h and FLAGS.LockPos then h.Anchored = true end
        if FLAGS.AutoSprint then
            local hum = GetHum()
            if hum then hum.WalkSpeed = math.max(FLAGS.SpeedValue, 100) end
        else
            local hum = GetHum()
            if hum then hum.WalkSpeed = FLAGS.SpeedValue end
        end
        lastPunch = 0; lastTool = 0; lastKill = 0
    end))

    StartAntiAFK()
    Notify("KhoiFarm loaded! Key: "..TargetKey)
end

