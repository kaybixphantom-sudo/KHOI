    GFSS.TextBox("Amount", "Số lượng", function(v) FLAGS.GiftShakeAmount = tonumber(v) or 0 end)
    GFSS.Toggle("Start Gifting Shake", "", function(s) FLAGS.GiftShake = s end)

    local GS = FT.NewSection("Auto Gift")
    GS.Toggle("Auto Collect Gift", "", function(s) FLAGS.AutoCollectGift = s end)

    local GSec = FT.NewSection("Anti Lag")
    GSec.Button("Anti Lag (all effects)", "", function()
        for _, v in pairs(game:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Trail")
            or v:IsA("Smoke") or v:IsA("Fire") then
                pcall(function() v.Enabled = false end)
            end
        end
        Notify("Đã tắt hiệu ứng!")
    end)

    local ST = NewTab("Specs")
    local SSec = ST.NewSection("Player Stats")
    local nameLbl = SSec.Label("Name: N/A")
    local userLbl = SSec.Label("Username: N/A")
    local strLbl  = SSec.Label("Strength: N/A")
    local rebLbl  = SSec.Label("Rebirths: N/A")
    local durLbl  = SSec.Label("Durability: N/A")
    local agiLbl  = SSec.Label("Agility: N/A")
    local killLbl = SSec.Label("Kills: N/A")
    local evLbl   = SSec.Label("Evil Karma: N/A")
    local gdLbl   = SSec.Label("Good Karma: N/A")
    local brLbl   = SSec.Label("Brawls: N/A")

    local AdvS = ST.NewSection("Advanced Stats")
    local ehLbl = AdvS.Label("Enemy Health: N/A")
    local edLbl = AdvS.Label("Enemy Damage: N/A")
    local yhLbl = AdvS.Label("Your Health: N/A")
    local ydLbl = AdvS.Label("Your Damage: N/A")
    local hkLbl = AdvS.Label("Hits to Kill: N/A")

    local IT = NewTab("Inventory")
    local ISec = IT.NewSection("Backpack Items")
    local InvLbl = ISec.Label("Đang đọc...")
    local EquipLbl = ISec.Label("Equipped: ...")

    local TT = NewTab("Teleports")
    local TSec = TT.NewSection("Main")
