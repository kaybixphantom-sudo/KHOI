    FL.BackgroundTransparency = 1
    FL.TextColor3 = Color3.fromRGB(150,150,150)
    FL.Text = "Make by AduAnhKhoi"
    FL.Font = Enum.Font.Gotham; FL.TextSize = 12

    local checking = false
    local function Check()
        if checking then return end
        checking = true
        if KB.Text == TargetKey then
            SG:Destroy()
            task.wait(0.1)
            local ok, err = pcall(MakeUI)
            if not ok then warn("[KhoiFarm] Error: "..tostring(err)) end
        else
            KB.Text = "Sai Key!"
            KB.TextColor3 = Color3.fromRGB(255,0,0)
            task.wait(1)
            KB.Text = ""
            KB.TextColor3 = Color3.fromRGB(255,255,255)
        end
        checking = false
    end
    MB.MouseButton1Click:Connect(Check)
    FB.MouseButton1Click:Connect(Check)
