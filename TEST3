                Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
                track(b.MouseButton1Click:Connect(nxt))
                tl.Text = t..": "..options[1]
                if cb then pcall(cb, options[1]) end
            end

            return so
        end
        return tab
    end

