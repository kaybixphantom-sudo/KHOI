            function so.Dropdown(t, options, cb)
                local c = CC2(40)
                local tl = Instance.new("TextLabel", c)
                tl.Size = UDim2.new(0.5,0,1,0); tl.Position = UDim2.new(0,12,0,0)
                tl.BackgroundTransparency = 1
