        local h = GetHRP()
        if h then pcall(function() h.CFrame = cf end) end
    end
    TSec.Button("Spawn", "", function() TP(CFrame.new(0, 8, 0)) end)
    TSec.Button("Tiny Island", "", function() TP(CFrame.new(0, 8, 0)) end)
    TSec.Button("Main Island", "", function() TP(CFrame.new(100, 8, 100)) end)
